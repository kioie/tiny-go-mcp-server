{
  "$schema": "https://glama.ai/schemas/mcp.json",
  "name": "tiny-go-mcp",
  "version": "1.1.2",
  "title": "Tiny Go MCP Server",
  "description": "Reference stdio MCP server for testing clients and evaluating tinymcp: demo tools (add, subtract, greet), info resource, code_review prompt. ~5MB Docker image. tinymcp library also supports streamable HTTP, legacy SSE, resources, and prompts—see github.com/kioie/tiny-go-mcp-server. Not for production workloads.",
  "license": "MIT",
  "language": "go",
  "framework": "tinymcp",
  "type": "mcp_server",
  "status": "stable",
  "transport": ["stdio"],
  "tools": 3,
  "keywords": [
    "mcp",
    "go",
    "golang",
    "stdio",
    "model-context-protocol",
    "go-sdk",
    "tinymcp",
    "cursor",
    "claude",
    "llm",
    "docker",
    "resources",
    "prompts"
  ],
  "categories": [
    "Developer Tools",
    "AI Agents"
  ],
  "homepage": "https://github.com/kioie/tiny-go-mcp-server",
  "repository": {
    "url": "https://github.com/kioie/tiny-go-mcp-server",
    "source": "github",
    "subfolder": "cmd/tiny-go-mcp"
  },
  "packages": [
    {
      "registryType": "oci",
      "identifier": "ghcr.io/kioie/tiny-go-mcp:1.1.2",
      "version": "1.1.2",
      "transport": {
        "type": "stdio"
      }
    }
  ],
  "mcpServers": {
    "tiny-go-mcp": {
      "name": "tiny-go-mcp",
      "description": "Reference tinymcp server (demo only). Tools: add/subtract/greet for MCP wiring tests. Resource file:///info for read tests. Prompt code_review for prompt tests. Do not use for production math or messaging.",
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "ghcr.io/kioie/tiny-go-mcp:1.1.2"
      ],
      "env": {
        "TINY_GO_MCP_VERBOSE": ""
      },
      "capabilities": {
        "tools": {
          "enabled": true,
          "listChanged": true
        },
        "resources": {
          "enabled": true,
          "listChanged": true
        },
        "prompts": {
          "enabled": true,
          "listChanged": true
        }
      },
      "timeout": {
        "initialize": 30000,
        "message": 120000
      },
      "metadata": {
        "version": "1.1.2",
        "homepage": "https://github.com/kioie/tiny-go-mcp-server",
        "license": "MIT",
        "tags": ["go", "mcp", "stdio", "tinymcp", "resources", "prompts"],
        "categories": ["Developer Tools", "AI Agents"]
      }
    }
  },
  "maintainers": ["kioie"]
}
